{
  "name": "@gordonkit/docforge",
  "version": "0.1.0",
  "private": true,
  "description": "An AI-ready framework for creating consistent, editable Word (DOCX) documents from structured content.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "docforge": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "examples",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "node scripts/check-package.mjs",
    "check:release": "node scripts/check-release.mjs",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gordonkit/docforge.git"
  },
  "homepage": "https://docforge.gordonkit.com/",
  "bugs": {
    "url": "https://github.com/gordonkit/docforge/issues"
  },
  "keywords": [
    "docx",
    "word",
    "document",
    "report",
    "pandoc",
    "ai"
  ],
  "author": "GordonKit",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "fflate": "0.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
